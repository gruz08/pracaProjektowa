<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= name %></title>
    <link rel="stylesheet" href="/stylesheets/main.css">
</head>
<body>
    <%- include('../partials/header') %>

    <main>
        <user>
            <h1><%= user.name %></h1>
            <p class="meta">
                Imię: <%= user.name %><br>
                Wiek: <%= user.age %>
            </p>

            <div class="password"><%= user.password %></div>
            <a href="/">Powrót</a>
        </user>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>